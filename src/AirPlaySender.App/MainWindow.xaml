<Window
    x:Class="AirPlaySender.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AirPlaySender.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <local:InverseBoolConverter x:Key="InverseBoolConverter" />
        <local:StringToVisibilityConverter x:Key="StringToVisibility" />
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- custom title bar -->
        <Grid x:Name="TitleBarArea" Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="8">
                <SymbolIcon Symbol="Video" />
                <TextBlock Text="AirPlay per Windows" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid Grid.Row="1" Padding="20,8,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dispositivi disponibili" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="RescanButton" Click="OnRescanClicked" ToolTipService.ToolTip="Cerca di nuovo">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Aggiorna" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ProgressRing x:Name="ScanningRing" IsActive="False" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" />

                <TextBlock x:Name="EmptyStateText"
                           Text="Nessun dispositivo AirPlay trovato sulla rete. Assicurati che HomePod, Apple TV o lo speaker siano accesi e sulla stessa rete Wi-Fi, poi premi Aggiorna."
                           TextWrapping="Wrap" Opacity="0.7" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="40,80,40,0" TextAlignment="Center" Visibility="Collapsed" />

                <ListView x:Name="DeviceList" ItemsSource="{x:Bind Devices}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:DeviceItem">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="8" Padding="16,12" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <SymbolIcon Grid.Column="0" Symbol="Volume" Margin="0,0,14,0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{x:Bind Subtitle}" Opacity="0.65" FontSize="12" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" Opacity="0.8" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind StatusText, Mode=OneWay, Converter={StaticResource StringToVisibility}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <ProgressRing IsActive="{x:Bind IsBusy, Mode=OneWay}" Width="18" Height="18"
                                                      Visibility="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Disconnetti" Click="OnDisconnectClicked" Tag="{x:Bind}"
                                                Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Connetti" Click="OnConnectClicked" Tag="{x:Bind}" Style="{ThemeResource AccentButtonStyle}"
                                                IsEnabled="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                                Visibility="{x:Bind IsConnected, Mode=OneWay, Converter={StaticResource InverseBoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <!-- footer: volume + status for the active session -->
        <Border Grid.Row="2" x:Name="NowPlayingBar" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                Padding="20,12" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NowPlayingText" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <SymbolIcon Symbol="Volume" />
                    <Slider x:Name="VolumeSlider" Width="160" Minimum="0" Maximum="100" Value="100" ValueChanged="OnVolumeChanged" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
