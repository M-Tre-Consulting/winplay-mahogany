<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>AirPlaySender.App</RootNamespace>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- H264Mft.cs's NV12->BGRA inner loop is an unsafe pointer walk. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Unpackaged desktop app: no MSIX, runs as a plain .exe (simpler to build/distribute for Phase 1). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <!-- `dotnet build` uses the SDK's own MSBuild, whose $(MSBuildExtensionsPath)
         never points at a Visual Studio install — so the WindowsAppSDK/MRT-Core
         targets' default AppxMSBuildToolsPath (SDK-relative) never resolves,
         even though the "Universal Windows Platform development" VS workload
         is installed and genuinely has these tools. Point it at the real
         location directly rather than disabling the targets that need it one
         at a time (microsoft/WindowsAppSDK#4889 — a `dotnet build`-specific
         gap). Machine-specific: adjust or delete this line if your Visual
         Studio edition/path differs, or once building with `msbuild` directly
         instead of `dotnet build` makes it unnecessary. -->
    <AppxMSBuildToolsPath Condition="'$(AppxMSBuildToolsPath)' == '' AND Exists('C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\')">C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Microsoft\VisualStudio\v17.0\AppxPackage\</AppxMSBuildToolsPath>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- The app's own UI text is hardcoded Italian (no .resx localization),
         so the only thing satellite resources carry is other cultures'
         strings for WinAppSDK/WPF-interop internals we never show. Publish
         only en/it to keep the self-contained (installer) output from
         ballooning with ~40 unused language folders. -->
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- Tray icon for "stays running in the background" behavior. 2.4.1 (the
         newest stable release on NuGet — 2.4.2/2.5.0 only exist as -dev/-beta
         prereleases as of writing) dropped net9.0 support in favor of
         net10.0-windows, which this project (net9.0-windows10.0.19041.0)
         can't consume — 2.3.2 is the newest stable release still built for
         net9.0-windows. -->
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.3.2" />
    <!-- Mirroring render path (see README, "La caccia al bug del rendering"):
         Vortice.MediaFoundation drives the Windows H.264 decoder MFT directly
         (H264Mft.cs) — MediaPlayer/MediaStreamSource around the same decoder
         wedged solid ~1s into every live mirror stream, in both MediaPlayerElement
         and frame-server mode. Win2D blits each decoded frame onto a
         CanvasSwapChainPanel. 1.3.x is the Win2D branch for WindowsAppSDK 1.6;
         Vortice.MediaFoundation is pure P/Invoke (no extra native binaries). -->
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
    <!-- Mirroring audio is AAC-ELD (ct=8, 480 spf, 44100/2), which Windows' own
         AAC decoder can't handle — same reason UxPlay hard-requires libfdk-aac
         for mirror-mode audio. This package ships prebuilt Fraunhofer FDK AAC
         (libAACdec.dll) for win-x64/arm64; AacEldDecoder.cs P/Invokes it. NOTE:
         the FDK AAC codec carries a Fraunhofer license + an AAC patent notice
         (see the package's NOTICE.txt) — same footing as UxPlay. -->
    <PackageReference Include="fdk-aac" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AirPlaySender.Core\AirPlaySender.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon above embeds this in the .exe (Explorer/file icon). It's
         also copied next to the .exe so MainWindow can point AppWindow.SetIcon
         at it directly — for an unpackaged app the taskbar/titlebar icon isn't
         guaranteed to pick up the embedded resource on its own. -->
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>
